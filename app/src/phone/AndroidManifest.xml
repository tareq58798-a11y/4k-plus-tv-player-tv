<?xml version="1.0" encoding="utf-8"?>
<!--
  The phone and tablet build.

  The phone and tablet build runs the same screens as the television, in landscape, on a touch
  screen. It differs from the television build only in what it declares here and in its application
  id, so the two can sit on one device as separate apps.

  Leanback is declared but not required. Requiring it hides the app from every phone and tablet in
  the Play Store; leaving it out altogether would drop it from the Android TV listing, which this
  build does not appear in anyway - so optional is the honest description.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- A phone always has one. Overrides the shared manifest, which marks it optional for the
         sake of televisions - hence the explicit replace rather than a silent merge. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true"
        tools:replace="android:required" />
    <application>
        <!-- Landscape, like the television build. The screens are the television's, laid out for a
             wide picture with the artwork beside the text; held upright a phone would be showing a
             television screen turned on its side, which is what portrait looked like. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true" />
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The phone and tablet build.

  Leanback is declared but not required. Requiring it hides the app from every phone and tablet in
  the Play Store; leaving it out altogether would drop the app from the Android TV listing, which
  this build does not appear in anyway - so declaring it optional is the honest description of a
  build that runs on either.

  screenOrientation is deliberately absent, so a phone held upright stays upright. The TV build
  declares landscape in src/tv and is unaffected by this file.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- A phone always has one. Overrides the shared manifest, which marks it optional for the
         sake of televisions - hence the explicit replace rather than a silent merge. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true"
        tools:replace="android:required" />
    <application>
        <!-- Playback carries on in a floating window while something else is used. Declared here
             rather than in the shared manifest: the television build has its own arrangement for
             this, driven by its own player. -->
        <activity
            android:name=".MainActivity"
            android:supportsPictureInPicture="true" />
    </application>
</manifest>

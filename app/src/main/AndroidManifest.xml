<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android TV has no touchscreen and is driven entirely by a D-pad remote; declaring the
         touchscreen optional (rather than leaving the implicit default of "required") is what
         lets the app appear on TV devices in the Play Store at all. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- android.software.leanback and the activity's screenOrientation are declared per form
         factor, in src/tv and src/phone, not here. A television must require leanback and stay
         landscape; a phone must do neither. Keeping them out of the shared manifest is what lets
         the two builds differ without either one being able to change the other. -->

    <queries>
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
    </queries>

    <application
        android:name=".FourKPlusApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="4K Plus TV Player"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.FourKPlus">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Additional to the LAUNCHER filter above, so the Leanback launcher on TV finds
                 this activity as the app's entry point too. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
